<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_events" model="ir.cron">
        <field name="name">Webhook Inbox: process pending events</field>
        <field name="model_id" ref="model_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_cleanup_events" model="ir.cron">
        <field name="name">Webhook Inbox: delete old processed events</field>
        <field name="model_id" ref="model_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
