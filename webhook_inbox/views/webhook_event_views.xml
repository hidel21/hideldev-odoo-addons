<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webhook_event_list" model="ir.ui.view">
        <field name="name">webhook.event.list</field>
        <field name="model">webhook.event</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'done'" decoration-warning="state in ('pending', 'error')"
                  decoration-danger="state == 'failed'">
                <header>
                    <button name="action_retry" type="object" string="Retry"/>
                    <button name="action_mark_done" type="object" string="Mark as done"/>
                </header>
                <field name="received_at"/>
                <field name="endpoint_id"/>
                <field name="event_uid"/>
                <field name="attempts" optional="show"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="remote_addr" optional="hide"/>
                <field name="processed_at" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state in ('pending', 'error')" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_event_form" model="ir.ui.view">
        <field name="name">webhook.event.form</field>
        <field name="model">webhook.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_process" type="object" string="Process now" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            invisible="state not in ('error', 'failed')"/>
                    <button name="action_mark_done" type="object" string="Mark as done"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="event_uid"/>
                        <h1><field name="event_uid"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id"/>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_attempt_at" invisible="state != 'error'"/>
                            <field name="remote_addr"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error"/>
                    </div>
                    <notebook>
                        <page string="Payload" name="payload">
                            <field name="payload_pretty" widget="text" class="font-monospace"/>
                        </page>
                        <page string="Headers" name="headers">
                            <field name="headers" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_webhook_event_search" model="ir.ui.view">
        <field name="name">webhook.event.search</field>
        <field name="model">webhook.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_uid"/>
                <field name="endpoint_id"/>
                <field name="payload"/>
                <filter name="filter_todo" string="To process" domain="[('state', 'in', ('pending', 'error'))]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_today" string="Received today"
                        domain="[('received_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_endpoint" string="Endpoint" context="{'group_by': 'endpoint_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'received_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_webhook_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webhook_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No webhook received yet</p>
            <p>Create an endpoint, copy its URL and paste it in the sending system.</p>
        </field>
    </record>
</odoo>
